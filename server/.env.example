# Option A: Connection String (Recommended for Supabase / Render / Railway)
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Option B: Or Separate Environment Parameters
