# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_supabase_password
# DB_SSL=true

# Server Configuration
PORT=3000
JWT_SECRET=super_secret_jwt_key_shopee_repair_2026

